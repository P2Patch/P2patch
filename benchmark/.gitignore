# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.egg-info/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Cloned vulnerable project checkouts. These are large, per-CVE git checkouts
# reconstructed on demand from project_info.csv (repo URL + buggy_commit_id) --
# see the README. They are never committed: the commit id IS the record.
dataset/project-sources/

# fixpov/respov validate scratch: temporary before/after project checkouts + build logs
.fixpov_validate/
.respov_validate/
# respov reverify scratch: per-tree checkouts (incl. full upstream clones) + build logs.
# The RESULT (residual_povs/verification/*.json) is checked in; the trees are not.
.respov_verify/
# ad hoc POV-authoring debug scratch (fixture generators, crash harnesses, etc.)
.pov_work/

# Logs
*.log
logs/

# Secrets / credentials (never commit)
*.pem
*.key
credentials.json
service-account*.json
