# Third-party clones. Never committed — `setup.sh` recreates them from pins.json.
# They are nested git repos (the same reason security_pipeline_runs/ is ignored)
# and one of them (looprepair) ships without a license, so vendoring would be
# redistribution we have no right to do.
vendor/

# Scratch: container state, baseline logs, raw tool output, intermediate runs.
# Anything here that is worth keeping gets normalized into results/ instead.
work/

# Secrets for the baselines' own LLM backends (they read .env / .env_example).
.env
*/.env
